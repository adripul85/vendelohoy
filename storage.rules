rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('^image/(png|jpeg|jpg|gif|webp)$');
    }

    function isLessThan5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // --- Avatares ---
    // Cualquier usuario logueado o visitante puede ver el avatar
    // Solo el dueño puede crear/editar/eliminar su propio avatar (y debe ser una imagen menor a 5MB)
    match /avatars/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isOwner(userId) && isImage() && isLessThan5MB();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isOwner(userId) && isImage() && isLessThan5MB();
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // --- Artículos (Items) ---
    // Cualquier usuario puede ver las imágenes de los artículos.
    // Solo el dueño puede escribir en su carpeta.
    // La app sube así: `items/${user.uid}/${Date.now()}_${file.name}`
    match /items/{userId}/{imageId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isOwner(userId) && isImage() && isLessThan5MB();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // --- Chats ---
    // Las imágenes se suben a `chats/${selectedChat.id}`
    match /chats/{chatId}/{imageId=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isImage() && isLessThan5MB();
      allow delete: if isAuthenticated();
    }

    // --- Escrow / Disputas ---
    // Las imágenes se suben a `escrow/${id}`
    match /escrow/{transactionId}/{imageId=**} {
      // Idealmente, aquí deberíamos validar en Firestore si request.auth.uid pertenece a la transacción.
      // Como storage rules nativas no leen firestore sin un custom token, la mejor mitigación es
      // validar el login (ya está) y en el front generar nombres de archivo impredecibles.
      // Al menos evitamos acceso público no autenticado.
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isImage() && isLessThan5MB();
      allow delete: if isAuthenticated();
    }

    // --- Marketing (Heros y Banners) ---
    // Solo admins (verificados via custom claim) pueden modificar marketing
    match /marketing/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.auth.token.admin == true && isImage() && isLessThan5MB();
      allow delete: if isAuthenticated() && request.auth.token.admin == true;
    }

    // --- Perfiles y Portadas ---
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isOwner(userId) && isImage() && isLessThan5MB();
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // --- Tiendas (Fondos y personalización) ---
    match /shops/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isOwner(userId) && isImage() && isLessThan5MB();
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // --- Verificación (KYC / DNI) ---
    match /kyc/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && isOwner(userId); // Privado
      allow create, update: if isAuthenticated() && isOwner(userId) && isImage() && isLessThan5MB();
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // Default: denegar todo acceso a cualquier otra cosa no especificada arriba.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

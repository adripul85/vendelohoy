rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario es Admin (usando campo en el documento)
    function isAdmin() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.isAdmin == true || userData.role == 'admin';
    }

    // REGLAS PARA TRANSACCIONES
    match /transactions/{transactionId} {
      // Leer: Comprador, Vendedor o Admin
      allow read: if request.auth != null && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      
      // Crear: Cualquier usuario autenticado puede iniciar un trato
      allow create: if request.auth != null && request.resource.data.buyerId == request.auth.uid;
      
      // Actualizar: PROTECCIÓN CRÍTICA
      allow update: if request.auth != null && (
        isAdmin() || (
          // El usuario solo puede cambiar el estado bajo reglas estrictas (FSM limitado)
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'trackingId', 'courier', 'deliveredAt', 'inspectionDeadline', 'disputeReason', 'disputeStartedAt', 'lastSystemMessage', 'isAmicableReturnAccepted', 'paidAt', 'paymentId', 'paymentStatus']) && (
            // Regla: Pasar a DISPUTED es permitido para Comprador/Vendedor
            (request.resource.data.status == 'DISPUTED' && resource.data.status != 'COMPLETED' && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid)) ||
            // Regla: El COMPRADOR libera fondos (Completa el trato)
            (request.resource.data.status == 'COMPLETED' && resource.data.status != 'DISPUTED' && resource.data.buyerId == request.auth.uid) ||
            // Regla: EL VENDEDOR registra envío
            (request.resource.data.status == 'SHIPPED' && resource.data.status == 'PAID_HELD' && resource.data.sellerId == request.auth.uid) ||
            // PAID_HELD: SOLO se puede establecer desde el backend (webhook MP / Admin SDK)
            // La única excepción client-side es la devolución amigable (DISPUTED -> PAID_HELD por vendedor)
            // Regla: Devolución amigable (vendedor acepta devolver desde disputa)
            (request.resource.data.status == 'PAID_HELD' && resource.data.status == 'DISPUTED' && resource.data.sellerId == request.auth.uid && request.resource.data.isAmicableReturnAccepted == true) ||
            // Regla: Comprador o Vendedor pueden cancelar si está PENDING_PAYMENT
            (request.resource.data.status == 'CANCELLED' && resource.data.status == 'PENDING_PAYMENT' && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid))
          )
        )
      );
      
      allow delete: if isAdmin();

      // Reglas para subcolecciones de mensajes (Disputas/Garantía)
      match /messages/{messageId} {
        allow read, create: if request.auth != null && (
          get(/databases/$(database)/documents/transactions/$(transactionId)).data.buyerId == request.auth.uid ||
          get(/databases/$(database)/documents/transactions/$(transactionId)).data.sellerId == request.auth.uid ||
          isAdmin()
        );
      }
      
      // Reglas para subcolecciones de evidencia
      match /evidence/{evidenceId} {
        allow read, create: if request.auth != null && (
          get(/databases/$(database)/documents/transactions/$(transactionId)).data.buyerId == request.auth.uid ||
          get(/databases/$(database)/documents/transactions/$(transactionId)).data.sellerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // REGLAS PARA REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.reviewerId == request.auth.uid;
    }
    
    // REGLAS PARA LOGS DE REPUTACION
    match /reputationLogs/{logId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null;
    }

    // REGLAS PARA MOVIMIENTOS DE BILLETERA
    match /walletMovements/{movementId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /wallet_movements/{movementId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // REGLAS PARA NOTIFICACIONES (subcolección en users)
    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // REGLAS PARA RETIROS (WITHDRAWALS)
    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    
    // REGLAS PARA USUARIOS
    match /users/{userId} {
      allow read: if true; // Permitir que visitantes y compradores vean el perfil y nombre del vendedor
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Actualización del propio usuario: bloquear campos sensibles
      allow update: if request.auth != null && (
        // El propio usuario puede editarse, excepto campos protegidos financieros, de rol y de reputación
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['balance', 'isAdmin', 'wallet', 'wallet.available', 'wallet.inEscrow', 'wallet.pending', 'wallet.lastUpdated', 'salesCount', 'successfulSales', 'reputation', 'reputationPoints', 'points', 'trustLevel', 'sellerStatus', 'rating', 'lastDailyXpDate'])) ||
        // Admin puede todo
        isAdmin()
      );
    }

    // REGLAS PARA PRODUCTOS (ITEMS)
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if (request.auth != null && (resource.data.sellerId == request.auth.uid || isAdmin())) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      allow delete: if request.auth != null && (resource.data.sellerId == request.auth.uid || isAdmin());
      
      // Subcolección: Historial de stock
      match /stock_history/{historyId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/items/$(itemId)).data.sellerId == request.auth.uid || isAdmin()
        );
      }
    }
    
    // REGLAS PARA CHATS
    match /chats/{chatId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants || 
        isAdmin()
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // REGLAS PARA PREGUNTAS
    match /questions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.buyerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
    }

    // REGLAS GLOBALES (MARKETING Y PLATAFORMA) — Solo Admin puede escribir
    match /platform/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    match /marketing_hero/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    match /marketing_broadcasts/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    match /category_banners/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    match /marketing_collections/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    match /marketing_notifications/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    match /coupons/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
    match /reports/{document=**} {
      allow read: if request.auth != null && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
    }
    match /disputes/{document=**} {
      allow read: if request.auth != null && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
    }
    match /verifications/{document=**} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && isAdmin();
    }
    match /store_registry/{document=**} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.ownerId == request.auth.uid || isAdmin());
    }
    match /financial_logs/{document=**} {
      allow read: if isAdmin();
      allow write: if request.auth != null && isAdmin();
    }
    match /store_events/{document=**} {
      allow create: if true;
      allow read: if request.auth != null && isAdmin();
    }
    
    // PERMITIR SUBCONJUNTOS EN USERS (COMO FAVORITOS)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
